# ============================================================================
# Example Environment Variables for RAG Chatbot
# Copy this file to .env and fill in your actual values
# T056 - Phase 7: Docker Compose & deployment configuration
# ============================================================================

# ============================================================================
# OpenAI API Configuration (REQUIRED)
# ============================================================================
OPENAI_API_KEY=sk-proj-your-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ============================================================================
# PostgreSQL Configuration
# Option 1: Docker Compose (local development)
# ============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=ragchatbot
POSTGRES_PASSWORD=dev_password_change_in_production
POSTGRES_DB=ragchatbot

# Option 2: Cloud/Production (Neon, AWS RDS, etc.) - use DATABASE_URL instead
# DATABASE_URL=postgresql://user:password@host.neon.tech:5432/dbname

# ============================================================================
# Qdrant Vector Database Configuration
# Option 1: Docker Compose (local development)
# ============================================================================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=physical_ai_book

# Option 2: Cloud/Production (Qdrant Cloud)
# QDRANT_URL=https://your-cluster.cloud.qdrant.io
# QDRANT_API_KEY=your-qdrant-api-key-here

# ============================================================================
# Application Settings
# ============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_PORT=8000
API_HOST=0.0.0.0
API_PORT=8000

# ============================================================================
# CORS Configuration
# ============================================================================
# Comma-separated list of allowed origins
# For local dev: http://localhost:3000,http://localhost:8080
# For production: https://assadsharif.github.io
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://assadsharif.github.io

# ============================================================================
# Rate Limiting
# ============================================================================
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_QUERIES_PER_MINUTE=10

# ============================================================================
# Performance Tuning
# ============================================================================
CHUNK_RETRIEVAL_COUNT=5
RETRIEVAL_TIMEOUT_SECONDS=2
SYNTHESIS_TIMEOUT_SECONDS=2
